# Local-only credential/config files — never committed. Only the *.template
# versions in infra/ are tracked.
infra/**/.env
infra/**/certs/
infra/continuwuity/continuwuity.toml

# Byte-cache from running/syntax-checking the Python tools on a node.
__pycache__/
*.pyc

# Node dependencies (services/minecraft-bots/) -- package-lock.json is tracked, the installed
# tree itself is not, same convention as every other language's dependency directory here.
node_modules/
