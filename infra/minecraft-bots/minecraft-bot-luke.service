[Unit]
Description=Firmament Minecraft Bot (Luke_Soldier)
After=network-online.target hermes-router.service hermes-memory.service hermes-buzz.service continuwuity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MC_BOT_USERNAME=Luke_Soldier
# 2026-11-26 rename ("rename the bots to be name-<role>"): pins this bot's own stable identity
# (persona, Matrix account, memory paths -- see index.js 3.1.0) while MC_BOT_USERNAME above
# becomes the new in-game display name other players and bots actually see.
Environment=MC_BOT_PERSONA=luke
# MC_SELF_DEFENSE_FLEE_HEALTH retired 2026-09-21: replaced by index.js's own role-based
# decideFightType() (Soldiers fight always, regardless of any per-bot health threshold).
Environment=MC_SELF_DEFENSE_RANGE=20
Environment=MC_SQUAD_RESPONDER=true
# Firmament observability (FIRMAMENT_OBSERVABILITY_PLAN.md): this bot's own Prometheus /metrics
# listener (metrics.js) -- see infra/minecraft-bots/README.md §7 for the port roster and
# the ufw rule it needs on this host.
Environment=MC_BOT_METRICS_PORT=9113
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
