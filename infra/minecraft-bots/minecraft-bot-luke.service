[Unit]
Description=Firmament Minecraft Bot (Luke)
After=network-online.target hermes-router.service hermes-memory.service hermes-buzz.service continuwuity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MC_BOT_USERNAME=Luke
Environment=MC_SELF_DEFENSE_FLEE_HEALTH=4
Environment=MC_SELF_DEFENSE_RANGE=20
Environment=MC_SQUAD_RESPONDER=true
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
