[Unit]
Description=Firmament Minecraft Bot (Babs)
After=network-online.target hermes-router.service hermes-memory.service hermes-buzz.service continuwuity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MC_BOT_USERNAME=Babs
# 2026-09-19 ("expand their search capabilities... especially the miner and explorer roles"):
# Babs is the fleet's one Miner -- searches ore/log up to 40 blocks instead of the shared
# 32-block default (kept under actions.js's own documented 48-block pathfinder OOM ceiling).
Environment=MC_MINE_SEARCH_RADIUS=40
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
