[Unit]
Description=Firmament Minecraft Bot (Amy_Builder)
After=network-online.target hermes-router.service hermes-memory.service hermes-buzz.service continuwuity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MC_BOT_USERNAME=Amy_Builder
# 2026-11-26 rename ("rename the bots to be name-<role>"): pins this bot's own stable identity
# (persona, Matrix account, memory paths -- see index.js 3.1.0) while MC_BOT_USERNAME above
# becomes the new in-game display name other players and bots actually see.
Environment=MC_BOT_PERSONA=amy
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
