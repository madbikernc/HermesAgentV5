[Unit]
Description=Firmament Minecraft Bot (Nell)
After=network-online.target hermes-router.service hermes-memory.service hermes-buzz.service continuwuity.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MC_BOT_USERNAME=Nell
# spark2 has no RAG index or embedder: search/notes/skills go to spark's hermes-minecraft-rag (8105)
Environment=MC_RAG_URL=http://10.129.1.15:8105
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/run-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
