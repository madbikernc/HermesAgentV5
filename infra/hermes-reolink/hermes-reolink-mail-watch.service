[Unit]
Description=Hermes reolink mail-watch - interim Reolink AI-detection alerting via the camera's own native email (no local API on this camera, see hermes-reolink.py's own header comment)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-reolink/README.md
After=network-online.target hermes-memory.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-reolink-mail-watch-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
