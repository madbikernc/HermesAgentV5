[Unit]
Description=Hermes screen - on-demand text-classification utility (Buzz screen-topic subscriber)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-screen/README.md
After=network-online.target hermes-buzz.service hermes-memory.service hermes-guard.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-screen-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
