[Unit]
Description=hermes-market-sync daily run (S38b/c/h/o) — instruments, nasdaq100, tags, prices, tag-scout
After=network-online.target hermes-router.service
Wants=network-online.target

[Service]
Type=oneshot
User=pmoney
ExecStart=/usr/bin/python3 /home/pmoney/HermesAgentV5/tools/hermes-market-sync.py daily
StandardOutput=journal
StandardError=journal
