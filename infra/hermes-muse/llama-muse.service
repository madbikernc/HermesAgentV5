# /etc/systemd/system/llama-muse.service
[Unit]
Description=llama.cpp server - NVIDIA-Nemotron-3-Nano-Omni-30B-A3B-Reasoning (Muse, persona/override-resistance backend, spark-2, text-only load)
After=network.target

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/opt/llama.cpp/start-muse.sh
Restart=always
RestartSec=15
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
