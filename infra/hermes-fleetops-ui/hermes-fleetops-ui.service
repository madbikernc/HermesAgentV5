[Unit]
Description=hermes-fleetops-ui - read-only browser view of the fleet's reports and backlogs
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-fleetops-ui/README.md
After=network-online.target hermes-router.service hermes-memory.service
Wants=network-online.target

[Service]
Type=simple
User=pmoney
Group=pmoney
# TLS is terminated by `tailscale serve` on the tailnet, with a real Let's Encrypt certificate for
# spark.tail1a534.ts.net, which proxies to this loopback socket. So this process must NOT be
# reachable from the tailnet itself -- otherwise there is a plaintext way in beside the encrypted
# one, and Basic Auth would cross the wire in the clear for anyone who used it.
#
# Port 443 is not available for this: tailscaled already serves `/` there to the Matrix homeserver
# on localhost:6167, and displacing that would break Matrix clients and federation. The TLS port is
# 8103 -- the same number this service was already documented on -- and the plain-HTTP backend
# moved to 8104.
Environment=FLEETOPS_UI_BIND=127.0.0.1
Environment=FLEETOPS_UI_PORT=8104
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-fleetops-ui-wrapper.sh
Restart=on-failure
RestartSec=10s
# The write routes this service does serve (model-scout/self-repair decisions, the market
# watchlist's add, and the budget classifier) stay deliberately narrow: hermes-memory's own HTTP
# API for the first two, and two specific, explicitly-granted local paths below for the rest --
# never a blanket writable filesystem. Enforced here as well as in the code, rather than only
# asserted.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# The one exception, and it is not optional: ~/.hermes/state/usage.db is in WAL mode, and a
# read-only SQLite connection to a WAL database still has to take a read mark in the `-shm`
# sidecar, which needs write access to the directory. With the whole tree read-only the usage
# section failed with "unable to open database file" -- found on the first real start, not
# reasoned about in advance.
#
# Narrower grants were tried and do not work: systemd rejects a single FILE in ReadWritePaths
# (exit 226/NAMESPACE), and bind-mounting the sidecars individually is impossible because SQLite
# unlinks `-shm` when the last writer closes, so the path to bind is often absent at start --
# observed live, mid-test. /mnt/hermes-data (memory.db, vectors.db, the RAG store), the repo and
# /etc all stay read-only, verified by test rather than assumed.
#
# What this grant does NOT confer: authority over the model-scout approvals this UI surfaces.
# Those live in memory.db's task states under /mnt, which stays read-only. What is in this
# directory is a last-seen Matrix cursor (model-scout-gate/state.json, 26 bytes, "a last-seen
# cursor only" per the gate's own docs), the Layer-1 guard's scan log, and assorted per-tool
# state JSONs -- all of which every other pmoney-owned service on this host can already write,
# since none of them is sandboxed at all.
#
# The clean fix is to give usage.db its own directory via HERMES_USAGE_DB, which
# hermes_usage_log.py already honours, and bind only that. It means changing the writers' units
# and relocating a live 50MB database, so it is recorded as a follow-up rather than done here.
ReadWritePaths=/home/pmoney/.hermes/state
# A second, narrower exception: /mnt/hermes-data/finance specifically, for the budget
# classifier's one write route (/budget/classify, direct operator request). Every other read on
# this page stays read-only via the same mode=ro URI pattern market.db/memory.db already use;
# this is the first feature on this page whose own job IS to let the operator correct a stored
# record, not just report on one, and finance.db is where that correction has to land. Found live,
# not reasoned about in advance: the first real Save attempt failed with
# "sqlite3.OperationalError: attempt to write a readonly database" even though the file's own Unix
# permissions already allowed pmoney to write it -- ProtectSystem=strict overrides that regardless
# of file mode, for every path not named here. The rest of /mnt/hermes-data (memory.db, market.db,
# vectors.db, the RAG store) stays read-only; this grant is scoped to the one subdirectory that
# needs it, the same "as narrow as systemd allows" rule the state-dir grant above follows.
ReadWritePaths=/mnt/hermes-data/finance
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
