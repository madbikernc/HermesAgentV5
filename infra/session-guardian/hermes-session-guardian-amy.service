[Unit]
Description=hermes-session-guardian (Amy) - detects stuck sessions, alerts, Boss-triggered cleanup
After=network.target hermes-gateway-amy.service

[Service]
Type=simple
User=amy
Environment=VAULT_NODE=amy
WorkingDirectory=/home/amy/HermesAgentV5
ExecStart=/home/amy/HermesAgentV5/tools/session-guardian.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
