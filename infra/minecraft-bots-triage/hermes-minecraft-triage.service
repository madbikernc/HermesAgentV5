[Unit]
Description=Firmament Minecraft bot log triage (coder/coder2 parallel diagnosis)
Documentation=file:///home/pmoney/HermesAgentV5/infra/minecraft-bots-triage/README.md
After=network-online.target hermes-router.service hermes-buzz.service minecraft-bot-babs.service minecraft-bot-amy.service
Wants=network-online.target
RequiresMountsFor=/mnt/hermes-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/tools
ExecStart=/usr/bin/python3 /home/pmoney/HermesAgentV5/tools/hermes-minecraft-triage.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
