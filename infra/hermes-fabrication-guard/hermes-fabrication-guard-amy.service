[Unit]
Description=hermes-fabrication-guard (Amy) - catches fabricated Weaver/Muse/render claims in real time
After=network.target hermes-gateway-amy.service

[Service]
Type=simple
User=amy
Environment=VAULT_NODE=amy
ExecStart=/home/amy/HermesAgentV5/tools/hermes-fabrication-guard.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
