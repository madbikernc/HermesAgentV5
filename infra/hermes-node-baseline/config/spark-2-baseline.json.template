{
  "_comment": "Copy to $HERMES_HOME/config/node-baseline.json on spark-2 and fill in real paths -- NOT committed to git with real values, same convention as node-health.json. spark-2 hosts coder2/Muse Glimmer (see tools/hermes-dualcoder.py's own header) -- no codesec venv lives here today, so syft_grype targets dpkg only; add a venv target if one is installed later.",
  "node_name": "spark-2",
  "retention_days": 30,
  "severity_threshold": "medium",
  "aide": {
    "enabled": true,
    "config_path": "/etc/aide/aide.conf"
  },
  "lynis": {
    "enabled": true,
    "report_path": "/var/log/lynis-report.dat",
    "default_warning_severity": "high",
    "default_suggestion_severity": "low",
    "severity_overrides": {}
  },
  "syft_grype": {
    "enabled": true,
    "targets": [
      {"name": "dpkg", "source": "dpkg-db:/var/lib/dpkg", "kind": "os-packages"}
    ]
  }
}
