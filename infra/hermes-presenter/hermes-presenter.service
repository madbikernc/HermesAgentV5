[Unit]
Description=Hermes presenter - the fleet's one interactive voice (thin Matrix client, passthrough only)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-presenter/README.md
After=network-online.target continuwuity.service hermes-buzz.service hermes-memory.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-presenter-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
