[Unit]
Description=Hermes self-repair bridge - generic detection->submission bridge for every registered domain (FLEET_SELFREPAIR_DESIGN.md §4.4)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-self-repair/README.md
After=network-online.target hermes-buzz.service hermes-memory.service hermes-minecraft-triage.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-self-repair-bridge-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
