[Unit]
Description=Hermes game-admin - Minecraft/Zomboid admin actions from Matrix chat (Buzz gameadmin-topic subscriber)
After=network-online.target hermes-buzz.service hermes-memory.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-game-admin-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
