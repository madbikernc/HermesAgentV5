[Unit]
Description=Firmament Minecraft Bots Activity Log (full raw journal mirror for later review)
After=minecraft-bot-babs.service minecraft-bot-amy.service minecraft-bot-mark.service minecraft-bot-luke.service minecraft-bot-mayor.service

[Service]
Type=simple
# journalctl glob (review MB-18, 2026-09-24): every minecraft-bot-* unit on this host, not a fixed
# five-name list that left spark2's bots unmirrored.
ExecStart=/usr/bin/journalctl -u minecraft-bot-*.service -f --no-pager -o short-iso
StandardOutput=append:/mnt/hermes-data/minecraft-memory/activity.log
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
