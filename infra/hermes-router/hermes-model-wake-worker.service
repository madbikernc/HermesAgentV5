[Unit]
Description=Hermes model wake worker - brings an on-demand model backend up on request (spark only)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-router/README.md
After=network-online.target hermes-broker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
Environment="WORKER_NAME=spark-wake"
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-model-wake-worker-wrapper.sh
Restart=always
RestartSec=15
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
