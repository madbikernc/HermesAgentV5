[Unit]
Description=hermes-zomboid-backup-pull - pull Zomboid world backups from muncraft box to NAS2
After=network.target mnt-nas2\x2dhermes\x2dbackup.automount
Wants=mnt-nas2\x2dhermes\x2dbackup.automount

[Service]
Type=oneshot
User=pmoney
ExecStart=/usr/bin/python3 /home/pmoney/HermesAgentV5/tools/hermes-zomboid-backup-pull.py --verbose
