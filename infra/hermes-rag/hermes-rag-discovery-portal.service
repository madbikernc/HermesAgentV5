[Unit]
Description=Hermes RAG source-discovery review portal (Phase 33) - browser UI for discovery_candidates
After=network-online.target hermes-embed.service
Wants=network-online.target
# vectors.db lives inside the LUKS container, which is never auto-mounted. After a reboot this
# will fail to start — and, found live 2026-09-03 (this exact unit sat dead for a week), Restart=
# always does NOT retry a failed *dependency* job, so without intervention it stays dead
# indefinitely, not "harmlessly." As of hermes-unlock.sh 1.1.0, running that script (already
# required after every reboot) restarts this unit if it's found inactive — that script is what
# actually makes this recoverable, not RestartSec/Restart= on their own. Same fix applies to
# hermes-broker.service, hermes-buzz.service, hermes-memory.service, hermes-guard.service.
RequiresMountsFor=/mnt/hermes-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
# Tailnet IP only -- a human's browser reaches this, not another fleet node,
# so LAN/internet exposure buys nothing (see hermes-rag-discovery-portal.py's
# own module docstring). Never set to 0.0.0.0.
Environment="PORTAL_BIND=100.96.59.79"
Environment="PORTAL_PORT=8093"
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-rag-discovery-portal-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
