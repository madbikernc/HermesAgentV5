[Unit]
Description=Firmament Minecraft bot tests - fast (unit + triage + ragserver)
Documentation=file:///home/pmoney/HermesAgentV5/services/minecraft-bots/tests/README.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/hermes-data
OnSuccess=minecraft-bots-tests-live.service
OnFailure=minecraft-bots-tests-live.service

[Service]
Type=oneshot
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MB_TEST_REPORT_DIR=/mnt/hermes-data/minecraft-memory/test-reports
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/tests/run.sh unit
TimeoutStartSec=10min
