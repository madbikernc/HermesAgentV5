[Unit]
Description=Firmament Minecraft bot tests - full-bot live scenarios (live-bot.test.mjs as MBProbe)
Documentation=file:///home/pmoney/HermesAgentV5/services/minecraft-bots/tests/README.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/hermes-data
OnSuccess=minecraft-bots-tests-baseline.service
OnFailure=minecraft-bots-tests-baseline.service

[Service]
Type=oneshot
User=pmoney
WorkingDirectory=/home/pmoney/HermesAgentV5/services/minecraft-bots
Environment=MB_TEST_REPORT_DIR=/mnt/hermes-data/minecraft-memory/test-reports
ExecStart=/home/pmoney/HermesAgentV5/services/minecraft-bots/tests/run.sh livebot
# 2026-11-07: measured 15-20min and growing as scenarios are added (7 scenarios at the time of
# writing) -- was previously sharing one 60min budget with live, unit, and baseline combined.
TimeoutStartSec=40min
