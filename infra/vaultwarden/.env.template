# Vaultwarden .env template — Hermes Fleet primary/standby.
# Version: 1.0.0
#
# Copy to `.env` next to docker-compose.yml and fill in real values. Never
# commit the filled-in .env itself — it's already covered by .gitignore.
# ADMIN_TOKEN: generate with `openssl rand -base64 48`. Guards the /admin panel.
ADMIN_TOKEN=CHANGEME

# DOMAIN: this instance's externally-visible URL. Primary (NAS2) and standby
# (NAS1) should each use their own real reachable URL, not copy each other's.
DOMAIN=CHANGEME

# SMTP: see smtp.env.template in this same directory for the one credential
# that can't itself live in the vault (outbound mail for invites/2FA).
SMTP_HOST=CHANGEME
SMTP_PORT=CHANGEME
SMTP_SECURITY=CHANGEME
SMTP_USERNAME=CHANGEME
SMTP_PASSWORD=CHANGEME
SMTP_FROM=CHANGEME
SMTP_FROM_NAME=CHANGEME
