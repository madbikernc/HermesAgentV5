[Unit]
Description=Hermes Buzz - topic-based pub/sub messaging plane for the fleet's agents
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-buzz/README.md
After=network-online.target
Wants=network-online.target
# The database lives inside the LUKS container, which is never auto-mounted. After a reboot this
# will fail to start — and, found live 2026-09-03, Restart=always does NOT retry a failed
# *dependency* job, so without intervention it stays dead indefinitely, not "harmlessly." As of
# hermes-unlock.sh 1.1.0, running that script (already required after every reboot) restarts this
# unit if it's found inactive — that script is what actually makes this recoverable, not
# RestartSec/Restart= on their own. Same fix applies to hermes-broker.service.
RequiresMountsFor=/mnt/hermes-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
Environment="BUZZ_DB=/mnt/hermes-data/buzz/messages.db"
Environment="BUZZ_BIND=10.129.1.15"
Environment="BUZZ_PORT=8101"
Environment="MATRIX_HOMESERVER=http://127.0.0.1:6167"
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-buzz-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
