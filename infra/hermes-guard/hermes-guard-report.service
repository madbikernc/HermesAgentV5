[Unit]
Description=hermes-guard-report - daily account of what the screening layers blocked, by caller
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-guard/README.md
# S33 fix (2026-10-21): hermes-guard-report.py 1.4.0 reads /mnt/hermes-data/memory/memory.db
# directly instead of calling hermes-memory over HTTP, so it now has the same real dependency on
# the LUKS mount every other reader of that file declares explicitly. This is a Type=oneshot
# triggered by its own timer, not Restart=always, so a run that hits Dependency failed here does
# not strand anything the way the seven long-running services in S32 did -- the next scheduled
# timer firing is a fresh start job and tries again on its own.
RequiresMountsFor=/mnt/hermes-data
After=network-online.target hermes-memory.service
Wants=network-online.target

[Service]
Type=oneshot
User=pmoney
Group=pmoney
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-guard-report-wrapper.sh
# A repeatedly-blocked caller exits 1 on purpose, so the regression is visible in
# `systemctl list-timers` and the journal as well as in chat. Not a crash; a signal.
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
