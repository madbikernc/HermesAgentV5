[Unit]
Description=Hermes guard - Layer 2 injection/jailbreak classifier (Llama Prompt Guard 2, stock, CPU-only)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-guard/README.md
After=network.target
# Model weights live inside the LUKS container, which is never auto-mounted. After a reboot this
# will fail to start — and, found live 2026-09-03, Restart=always does NOT retry a failed
# *dependency* job, so without intervention it stays dead indefinitely, not "harmlessly." As of
# hermes-unlock.sh 1.1.0, running that script (already required after every reboot) restarts this
# unit if it's found inactive — that script is what actually makes this recoverable, not
# RestartSec/Restart= on their own. Same applies to every other service reading from
# /mnt/hermes-data (hermes-broker, hermes-buzz, hermes-memory, hermes-rag-discovery-portal).
RequiresMountsFor=/mnt/hermes-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
Environment="GUARD_BIND=10.129.1.15"
Environment="GUARD_PORT=8096"
# S22c: Layer 2 is a stock LLM asked a narrow yes/no question, not Prompt-Guard-2-22M,
# which caught 4 of 18 injections and 0 of 6 indirect ones. Pinned here rather than left to
# the code default so the deployed intent is visible in systemd and ROLLING BACK IS THIS
# ONE LINE: set GUARD_MODE=classifier and restart. See infra/hermes-guard/README.md.
Environment="GUARD_MODE=llm"
# MUST be a backend, never hermes-router (port 8080): the router screens every request it
# proxies through this service, so a router URL here would screen its own screening calls
# recursively. hermes-guard.py refuses to start if this looks like the router.
#
# `omni` was the chosen arm (independent checkpoint, 18/18 accuracy) and was MEASURED NON-VIABLE
# on 2026-10-09: it is a dense 26B already serving the vision path, and at 6-way concurrency
# 94.4% of screening calls timed out, which fails Layer 2 OPEN exactly when load is highest.
# `dispatch` is the interim arm -- 35B-A3B (3B active) on loopback, the control-plane model
# already sized for many small calls. It scores the same 18/18 and loses only independence.
Environment="GUARD_LLM_URL=http://127.0.0.1:8097"
Environment="GUARD_LLM_ROLE=dispatch"
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-guard-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
