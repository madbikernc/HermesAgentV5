[Unit]
Description=Hermes guard - Layer 2 injection/jailbreak classifier (Llama Prompt Guard 2, stock, CPU-only)
Documentation=file:///home/pmoney/HermesAgentV5/infra/hermes-guard/README.md
After=network.target
# Model weights live inside the LUKS container, which is never auto-mounted. After a reboot this
# will fail to start — and, found live 2026-09-03, Restart=always does NOT retry a failed
# *dependency* job, so without intervention it stays dead indefinitely, not "harmlessly." As of
# hermes-unlock.sh 1.1.0, running that script (already required after every reboot) restarts this
# unit if it's found inactive — that script is what actually makes this recoverable, not
# RestartSec/Restart= on their own. Same applies to every other service reading from
# /mnt/hermes-data (hermes-broker, hermes-buzz, hermes-memory, hermes-rag-discovery-portal).
RequiresMountsFor=/mnt/hermes-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=pmoney
Group=pmoney
Environment="GUARD_BIND=10.129.1.15"
Environment="GUARD_PORT=8096"
# S22d: Layer 2 is a small DEDICATED prompt-injection classifier -- proventra/mdeberta-v3-base-
# prompt-injection (279M, MIT), measured 17/18 with 6/6 on indirect injections where
# Prompt-Guard-2-22M scored 4/18 and 0/6. Composite with Layer 1 is 18/18 after the role_tag_text
# fix in hermes_injection_guard 1.5.0.
#
# Chosen over the stock-LLM arms (S22b/S22c) because it is the only option that is BOTH independent
# of the model being protected AND free of contention: it runs on CPU in this service's own
# process, so it cannot queue behind a vision job the way `omni` did (94.4% timeouts at 6-way
# concurrency) and does not double the load on `dispatch`.
#
# ROLLBACK, in order of preference:
#   1. GUARD_MODE=llm with GUARD_LLM_URL=http://127.0.0.1:8097 / GUARD_LLM_ROLE=dispatch
#      (18/18, but ~1.2s p50 under concurrency and no independence)
#   2. GUARD_MODEL_DIR=/mnt/hermes-data/models/prompt-guard-2-22m (the original, 4/18)
Environment="GUARD_MODE=classifier"
Environment="GUARD_MODEL_DIR=/mnt/hermes-data/models/mdeberta-prompt-injection"
# Retained for rollback option 1; ignored while GUARD_MODE=classifier. MUST stay a backend, never
# hermes-router (port 8080) -- the router screens every request it proxies through this service, so
# a router URL would screen its own screening calls forever. hermes-guard.py refuses to start if
# GUARD_LLM_URL looks like the router.
Environment="GUARD_LLM_URL=http://127.0.0.1:8097"
Environment="GUARD_LLM_ROLE=dispatch"
ExecStart=/home/pmoney/HermesAgentV5/tools/hermes-guard-wrapper.sh
Restart=always
RestartSec=10
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
